{
    "version": 2,
    "regions": [
        "bom1"
    ],
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ]
}
